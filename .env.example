# Neon Postgres (pooler OK para la app; migraciones usan URL directa sin -pooler)
DATABASE_URL=postgresql://user:password@host/database
# Opcional en Vercel/Neon: conexión directa para DDL
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/database

# Stripe (Use TEST keys for development)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Email Configuration for Terms & Conditions PDF (using Resend)
RESEND_API_KEY=re_xxxxxxxxxx
OWNER_EMAIL=inversionrealconjorge@gmail.com
# Sender address. Must be on a domain verified in Resend to deliver to customers.
# Defaults to Resend's test domain (onboarding@resend.dev), which only delivers to the account owner.
EMAIL_FROM=contratos@tudominio.com

# Remitente para emails del programa de referidos (opcional; usa EMAIL_FROM si no se define)
REFERRAL_EMAIL_FROM=Inversión Real con Jorge y Guille <inversionrealconjorge@gmail.com>

# Login de miembros con Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord — vinculación obligatoria de miembros (OAuth2 + bot)
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=
# Mismo ID que APPLICATION_ID si no defines DISCORD_CLIENT_ID
# DISCORD_CLIENT_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_TRADER_ROLE_ID=
# En el Developer Portal → OAuth2, añade redirect:
# https://TU_DOMINIO/api/member/auth/discord/callback

# Cron Vercel (Hobby: 1×/día): /api/cron/sync-memberships — ver vercel.json (≈7 pm Miami en invierno)
CRON_SECRET=genera-un-secreto-largo-aleatorio

# Cloudflare R2 (vídeos academia, PDFs, imágenes de cursos) — ver docs/CLOUDFLARE_R2.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL pública del bucket (dominio r2.dev o custom): https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=
